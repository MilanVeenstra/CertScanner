{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "__MSG_action_title__" },
  "background": { "service_worker": "background/sw.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "commands": {
    "scan-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "__MSG_command_scan_page__" }
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["https://www.pricecharting.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
